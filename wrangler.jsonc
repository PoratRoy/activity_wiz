{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "activitywiz",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "activitywiz",
      "database_id": "c31527e6-0a23-4229-a7ed-2872df3884e1",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "observability": {
    "enabled": true
  },
  "vars": {
    "AUTH_TRUST_HOST": "true",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "SITE_URL": "https://activitywiz.porat-roy.workers.dev",
    "CONTACT_TO_EMAIL": "porat.roy@gmail.com",
    "CONTACT_FROM_EMAIL": "ActivityWiz <onboarding@resend.dev>"
  }
}
